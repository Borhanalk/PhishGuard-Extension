{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "1.0.0",
  "description": "Advanced Phishing Detection & Real-Time Protection Against Phishing & Typosquatting Attacks",

  "action": {
    "default_title": "PhishGuard Status",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "tabs",
    "storage",
    "webNavigation"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*"
  ],

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "warning.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
